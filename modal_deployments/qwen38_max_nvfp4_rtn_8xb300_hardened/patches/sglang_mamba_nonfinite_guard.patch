+    def slots_state_is_finite(self, indices: torch.Tensor) -> bool:
+        """True iff every conv + temporal state value at ``indices`` is finite.
+
+        Used as a cache-admission bulkhead: a request whose recurrent state was
+        poisoned by a transient NaN/Inf must never donate that state to the
+        radix tree (a cached non-finite state re-poisons every future request
+        that prefix-matches it). Costs one small reduction + a host sync per
+        call; callers gate on SGLANG_MAMBA_NONFINITE_CACHE_GUARD.
+        """
+        ok = torch.isfinite(self.mamba_cache.temporal[:, indices]).all()
+        for conv in self.mamba_cache.conv:
+            ok &= torch.isfinite(conv[:, indices]).all()
+        return bool(ok.item())
+
